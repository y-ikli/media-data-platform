[sqlfluff]
templater = dbt
dialect = duckdb
max_line_length = 120
# Le SQL est rendu par la cible duckdb (sans identifiants) : dialecte duckdb pour l'analyse.
# Exclus : alignement des alias (lisibilité choisie), indentation Jinja, ordre des colonnes, mots-clés en identifiants.
exclude_rules = LT01, LT02, LT03, LT05, LT08, LT09, ST06, RF04, AM04

[sqlfluff:templater:dbt]
project_dir = dbt/mdp
profiles_dir = dbt/mdp
profile = mdp
target = duckdb

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower
[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower
[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower
