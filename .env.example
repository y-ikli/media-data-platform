# Copier vers .env (jamais versionné).

# --- GCP (obligatoire hors --dry-run) -----------------------------------------
GCP_PROJECT_ID=your-gcp-project
# BQ_LOCATION=europe-west1
# BQ_RAW_DATASET=mdp_raw
# Authentification : `gcloud auth application-default login` (aucune clé JSON requise).

# --- dbt ----------------------------------------------------------------------
# DBT_TARGET=dev              # dev | prod | duckdb
# DBT_DEV_DATASET=mdp_dev

# --- Meta Ads (mode --mode real uniquement) -------------------------------------
# uv sync --extra meta
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=act_XXXXXXXXX
# Types d'actions comptés comme conversions (défaut : purchase, offsite_conversion.fb_pixel_purchase, omni_purchase)
# META_CONVERSION_ACTIONS=purchase
